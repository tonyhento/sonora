# =========================================================
# SONORA — CONFIGURAÇÃO
# Copie este arquivo para ".env" e preencha os valores.
# O .env NUNCA deve ir para o GitHub (já está no .gitignore).
# =========================================================

# Porta do servidor (http://localhost:3000)
PORT=3000

# Texto longo e aleatório usado para assinar o cookie de login.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# --- PostgreSQL local (os mesmos dados que você usa no pgAdmin) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=sua-senha-do-postgres
PGDATABASE=sonora

# --- Pagamento com cartão: Stripe em MODO DE TESTE (opcional) ---
# Painel do Stripe → Developers → API keys → Secret key (começa com sk_test_).
# Sem ela, Pix e boleto funcionam e o cartão avisa que não está configurado.
# Chaves reais (sk_live_) são recusadas.
STRIPE_SECRET_KEY=
# Opcional: segredo do webhook (stripe listen ... mostra um whsec_...)
STRIPE_WEBHOOK_SECRET=
# Endereço público do site, usado nos links dos e-mails e na volta do Stripe.
# OBRIGATÓRIO em produção. Localmente pode ficar vazio (usa http://localhost:PORT).
PUBLIC_URL=

# --- E-mails (opcional) ---
# Sem SMTP_HOST, nada é enviado: cada e-mail vira um arquivo .html na
# pasta outbox/ (o terminal mostra o caminho). Veja exemplos no README.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SONORA <no-reply@sonora.local>

# --- Tradução automática no painel admin (opcional) ---
# Sem chave, o painel usa o tradutor embutido do Chrome/Edge no computador.
# Com uma chave do DeepL (deepl.com → plano "DeepL API Free", 500 mil
# caracteres por mês), a tradução sai pelo servidor, em qualquer navegador.
DEEPL_API_KEY=

# --- Em produção (Render, Neon, Railway...) use a URL e remova as linhas acima ---
# DATABASE_URL=postgres://usuario:senha@host:5432/sonora
# DATABASE_SSL=true
# NODE_ENV=production
